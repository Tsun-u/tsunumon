# tsunumon - Environment Configuration
# Copy this file to .env and fill in your values

# Mode: dev or production
MODE=dev

# LLM Configuration
LLM_BACKEND=mock          # mock | claude
LLM_MODEL=claude-haiku-4-5-20251001
REVIEW_MODEL=claude-sonnet-4-6  # Vision 審核用
ANTHROPIC_API_KEY=

# Fact-check knowledge base: the default KB lives at
# https://tsun-u.github.io/tsunumon-kb (whitelisted in code). To allow
# additional hosts, list them here comma-separated, e.g. my-kb.example.com.
WEB_FETCH_EXTRA_DOMAINS=

# TTS Configuration
TTS_BACKEND=mock           # mock | kokoro | gcp | azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Slides Configuration
SLIDES_BACKEND=html        # mock | pillow | html

# Storage Configuration
STORAGE_BACKEND=local      # local | gcs
GCS_BUCKET=
GCS_PROJECT_ID=

# Server Configuration
HOST=0.0.0.0
PORT=8000
BASE_URL=                  # 對外 URL，空值時自動用 http://localhost:{PORT}
